#! /usr/bin/env bash

set -euo pipefail

source script/env "$@"

# This is the intentional online update-tool lock refresh path.
unset CARGO_NET_OFFLINE

require_cmd curl
require_cmd tar

sha256_file() {
  local file="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    sha256sum "$file" | awk '{print $1}'
  fi
}

fetch() {
  local url="$1"
  local dest="$2"

  mkdir -p "$(dirname "$dest")"
  curl -fsSL "$url" -o "$dest"
}

tool_version() {
  local name="$1"
  read_version_file "$DIR/.${name}-version"
}

lockfile="$DIR/update-tools.lock.toml"
tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/rust-template-update-tools.XXXXXX")"
entries_file="$tmpdir/update-tools.entries"

cleanup() {
  rm -rf "$tmpdir"
}
trap cleanup EXIT

: > "$entries_file"

add_tool() {
  local name="$1"
  local binary="$2"
  local version
  version="$(tool_version "$name")"
  if [[ -z "$version" ]]; then
    die ".${name}-version is required"
  fi

  local url="https://static.crates.io/crates/${name}/${name}-${version}.crate"
  local crate_file="$tmpdir/${name}-${version}.crate"
  local extract_dir="$tmpdir/${name}-extract"
  local source_dir="$extract_dir/${name}-${version}"

  echo "fetching $url"
  fetch "$url" "$crate_file"
  local crate_sha256
  crate_sha256="$(sha256_file "$crate_file")"

  rm -rf "$extract_dir"
  mkdir -p "$extract_dir"
  tar -xzf "$crate_file" -C "$extract_dir"

  if [[ ! -f "$source_dir/Cargo.toml" ]]; then
    die "${name} crate did not unpack to expected source directory"
  fi
  if [[ ! -f "$source_dir/Cargo.lock" ]]; then
    die "${name} crate does not include Cargo.lock"
  fi

  local crate_lockfile_sha256
  crate_lockfile_sha256="$(sha256_file "$source_dir/Cargo.lock")"

  printf '%s|%s|%s|%s|%s|%s\n' \
    "$name" "$binary" "$version" "$url" "$crate_sha256" "$crate_lockfile_sha256" >> "$entries_file"
}

add_tool cargo-audit cargo-audit
add_tool cargo-deny cargo-deny

{
  echo "# Locked online update-path Cargo tools."
  echo "# Generated by script/vendor-update-tools."
  echo
  echo "[update_tools]"
  echo "lock_version = 1"
  echo
  first_tool=true
  while IFS='|' read -r name binary version url crate_sha256 crate_lockfile_sha256; do
    if [[ "$first_tool" == "true" ]]; then
      first_tool=false
    else
      echo
    fi
    echo "[[tools]]"
    echo "name = \"$name\""
    echo "binary = \"$binary\""
    echo "version = \"$version\""
    echo "url = \"$url\""
    echo "crate_sha256 = \"$crate_sha256\""
    echo "crate_lockfile_sha256 = \"$crate_lockfile_sha256\""
  done < "$entries_file"
} > "$lockfile"

script/validate-update-tools --ci
echo -e "${GREEN}update-tool locks refreshed:${OFF} update-tools.lock.toml"
